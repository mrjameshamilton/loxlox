// Arbitrary-precision integers, used when converting number literals.
// A sign, and the absolute value as a little-endian linked list of base 2^26
// digits, so the product of two digits is exact.
var BIGINTEGER_BASE = 67108864;

class BigInteger {
    // value is any integer.
    init(value) {
        this.negative = value < 0;
        if (this.negative) value = -value;

        this.head = nil;
        var last  = nil;
        while (this.head == nil or value > 0) {
            var quotient = floor(value / BIGINTEGER_BASE);
            var digit    = this.newDigit(value - quotient * BIGINTEGER_BASE);
            if (last == nil) this.head = digit; else last.next = digit;
            last  = digit;
            value = quotient;
        }
    }

    newDigit(value) {
        class BigIntegerDigit { }
        var digit   = BigIntegerDigit();
        digit.value = value;
        digit.next  = nil;
        return digit;
    }

    // this = this + other
    add(other) {
        this.addSigned(other, other.negative);
    }

    // this = this - other
    subtract(other) {
        this.addSigned(other, !other.negative);
    }

    // this = this * other
    multiply(other) {
        var negative = this.negative != other.negative;

        // Schoolbook multiplication: add this * (each digit of other) into
        // the result, starting one digit further along each time.
        var result = BigInteger(0);
        var row    = result.head;
        var b      = other.head;
        while (b != nil) {
            var a     = this.head;
            var d     = row;
            var last  = nil;
            var carry = 0;
            while (a != nil or carry > 0) {
                if (d == nil) {
                    d = result.newDigit(0);
                    last.next = d;
                }
                var v = d.value + carry;
                if (a != nil) {
                    v = v + a.value * b.value;
                    a = a.next;
                }
                carry   = floor(v / BIGINTEGER_BASE);
                d.value = v - carry * BIGINTEGER_BASE;
                last = d;
                d    = d.next;
            }
            b = b.next;
            if (b != nil) {
                if (row.next == nil) row.next = result.newDigit(0);
                row = row.next;
            }
        }

        this.head     = result.head;
        this.negative = negative and !this.isZero();
    }

    // this = this * 2
    shiftLeft() {
        this.addAbs(this);
    }

    // Returns -1, 0 or 1.
    compare(other) {
        if (this.negative != other.negative) {
            if (this.negative) return -1;
            return 1;
        }
        var c = this.compareAbs(other);
        if (this.negative) return -c;
        return c;
    }

    isZero() {
        var digit = this.head;
        while (digit != nil) {
            if (digit.value != 0) return false;
            digit = digit.next;
        }
        return true;
    }

    // this = this + other, using otherNegative as other's sign. This lets
    // subtract pass other's sign flipped without modifying other (which may be this).
    addSigned(other, otherNegative) {
        if (this.negative == otherNegative) {
            this.addAbs(other);
        } else if (this.compareAbs(other) >= 0) {
            this.subtractAbs(other);
            if (this.isZero()) this.negative = false;
        } else {
            // |this| < |other|, so the result is |other| - |this|.
            var difference = BigInteger(0);
            difference.addAbs(other);
            difference.subtractAbs(this);
            this.head     = difference.head;
            this.negative = otherNegative;
        }
    }

    // |this| = |this| + |other|; other may be this.
    addAbs(other) {
        var carry = 0;
        var d     = this.head;
        var b     = other.head;
        var last  = nil;
        while (d != nil or b != nil or carry > 0) {
            if (d == nil) {
                d = this.newDigit(0);
                last.next = d;
            }
            var v = d.value + carry;
            if (b != nil) {
                v = v + b.value;
                b = b.next;
            }
            carry = 0;
            if (v >= BIGINTEGER_BASE) {
                v     = v - BIGINTEGER_BASE;
                carry = 1;
            }
            d.value = v;
            last = d;
            d    = d.next;
        }
    }

    // |this| = |this| - |other|, where |this| >= |other|; other may be this.
    subtractAbs(other) {
        var borrow = 0;
        var d      = this.head;
        var b      = other.head;
        while (d != nil) {
            var v = d.value - borrow;
            if (b != nil) {
                v = v - b.value;
                b = b.next;
            }
            borrow = 0;
            if (v < 0) {
                v      = v + BIGINTEGER_BASE;
                borrow = 1;
            }
            d.value = v;
            d       = d.next;
        }
    }

    // Returns -1, 0 or 1, comparing |this| with |other|.
    compareAbs(other) {
        var result = 0;
        var a = this.head;
        var b = other.head;
        while (a != nil or b != nil) {
            var x = 0;
            var y = 0;
            if (a != nil) {
                x = a.value;
                a = a.next;
            }
            if (b != nil) {
                y = b.value;
                b = b.next;
            }
            // Later digits are more significant, so the last difference wins.
            if (x > y) result = 1;
            else if (x < y) result = -1;
        }
        return result;
    }
}

